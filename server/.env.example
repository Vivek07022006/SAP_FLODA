# =========================================================================
# FLODA - FAIRNESS-LED OPERATIONAL DISRUPTION ALLOCATION
# ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# 1. Server Configuration
PORT=4004

# 2. SAP HANA Cloud Database Configuration
HANA_HOST=your-hana-cloud-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=your-user
HANA_PASSWORD=your-password
HANA_SCHEMA=HACKFEST0238
HANA_DATABASE=Hackfest-DB

# 3. JWT Authentication Secret
JWT_SECRET=floda-sap-hackfest-super-secret-key-2026

# 4. AI Provider Selection
# Options: 'openai' (default live inference) | 'sap-ai-core' (SAP BTP Hub)
AI_PROVIDER=openai

# 5. OpenAI Configuration (Active when AI_PROVIDER=openai)
# Note: Never commit your actual API key or expose it to frontend code
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 6. SAP AI Core / Generative AI Hub Configuration
# Preserved for SAP BTP Generative AI Hub deployment path
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
FLODA_AI_MODEL=gpt-4o
FLODA_AI_DEPLOYMENT_ID=
