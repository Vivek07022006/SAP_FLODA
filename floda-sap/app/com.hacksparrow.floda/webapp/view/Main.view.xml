<mvc:View controllerName="com.hacksparrow.floda.controller.Main" displayBlock="true" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f" xmlns:form="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" core:require="{formatter: 'com/hacksparrow/floda/model/formatter'}">
  <f:DynamicPage id="commandCenter" class="flodaPage" toggleHeaderOnTitleClick="false">
    <f:title><f:DynamicPageTitle><f:heading><Title text="FLODA Command Center" level="H1"/></f:heading><f:content><ObjectStatus text="MULTI-AGENT RESILIENCE PLATFORM" state="Information" icon="sap-icon://shield"/></f:content><f:actions><Button text="Reset Demo" type="Emphasized" icon="sap-icon://refresh" press=".onResetDemo"/></f:actions></f:DynamicPageTitle></f:title>
    <f:content><IconTabBar id="screenTabs" class="flodaTabs" expandable="false" select=".onTabSelect">
      <items>
        <IconTabFilter key="overview" text="Overview" icon="sap-icon://home" selected="true"><VBox class="screenContent"><Title text="Operational Overview" level="H2"/><Text text="Live position across FLODA's fairness-first logistics network." class="screenSubtitle"/><HBox justifyContent="SpaceBetween" wrap="Wrap" class="summaryRow"><VBox class="summaryCard navyCard"><Text text="TOTAL MANIFESTS" class="metricLabel"/><Title text="{view>/summary/manifests}" level="H1" class="metricValue"/><Text text="Shipments evaluated" class="metricNote"/></VBox><VBox class="summaryCard amberCard"><Text text="PENDING APPROVALS" class="metricLabel"/><Title text="{view>/summary/pending}" level="H1" class="metricValue"/><Text text="Human decisions required" class="metricNote"/></VBox><VBox class="summaryCard greenCard"><Text text="AUTO-EXECUTED" class="metricLabel"/><Title text="{view>/summary/autoExecuted}" level="H1" class="metricValue"/><Text text="Standard-risk allocations" class="metricNote"/></VBox></HBox><Panel headerText="Command Status" class="commandPanel"><content><HBox alignItems="Center" class="statusLine"><core:Icon src="sap-icon://connected" color="#42d392"/><Text text="Agents online — monitor signals, rank fairly, reroute safely, and audit every decision."/></HBox></content></Panel></VBox></IconTabFilter>
        <IconTabFilter key="simulator" text="Disruption Simulator" icon="sap-icon://alert"><VBox class="screenContent"><Title text="Simulate a Supply-Chain Disruption" level="H2"/><Text text="The Disruption Sensing Agent records the event and immediately starts scenario planning." class="screenSubtitle"/><Panel class="formPanel" headerText="Disruption Signal"><content><form:Form editable="true"><form:layout><form:ColumnLayout columnsM="2" columnsL="3" columnsXL="4"/></form:layout><form:formContainers><form:FormContainer><form:formElements><form:FormElement label="Location"><form:fields><Input value="{view>/disruption/location}" placeholder="e.g. Suez Canal"/></form:fields></form:FormElement><form:FormElement label="Disruption type"><form:fields><Select selectedKey="{view>/disruption/chokepoint_type}"><items><core:Item key="customs_delay" text="Customs delay"/><core:Item key="weather" text="Weather"/><core:Item key="port_congestion" text="Port congestion"/><core:Item key="infrastructure_failure" text="Infrastructure failure"/></items></Select></form:fields></form:FormElement></form:formElements></form:FormContainer><form:FormContainer><form:formElements><form:FormElement label="Severity"><form:fields><Select selectedKey="{view>/disruption/severity}"><items><core:Item key="low" text="Low"/><core:Item key="medium" text="Medium"/><core:Item key="high" text="High"/><core:Item key="critical" text="Critical"/></items></Select></form:fields></form:FormElement><form:FormElement label="Affected routes"><form:fields><Input value="{view>/disruption/affected_routes}" placeholder="e.g. Asia–Europe"/></form:fields></form:FormElement></form:formElements></form:FormContainer><form:FormContainer><form:formElements><form:FormElement label="Capacity reduction"><form:fields><VBox><Slider min="0" max="100" value="{view>/disruption/capacity_reduction_percent}"/><Text text="{view>/disruption/capacity_reduction_percent}% capacity reduction"/></VBox></form:fields></form:FormElement><form:FormElement label="Est. resolution (hours)"><form:fields><Input type="Number" value="{view>/disruption/estimated_resolution_hours}"/></form:fields></form:FormElement></form:formElements></form:FormContainer></form:formContainers></form:Form><Button text="Trigger Disruption" type="Emphasized" icon="sap-icon://alert" press=".onTriggerDisruption" class="triggerButton"/></content></Panel></VBox></IconTabFilter>
        <IconTabFilter key="rankings" text="Live Rankings" icon="sap-icon://sort"><VBox class="screenContent"><Title text="Live Fairness Rankings" level="H2"/><Text text="Every shipment is ranked only on substitutability, cover clock, degradation clock, and carriage fit." class="screenSubtitle"/><List items="{view>/rankings}" noDataText="Trigger a disruption to calculate live rankings." class="rankingList"><headerToolbar><OverflowToolbar><Title text="Priority queue"/><ToolbarSpacer/><Button text="Refresh" icon="sap-icon://refresh" type="Transparent" press=".onRefresh"/></OverflowToolbar></headerToolbar><items><CustomListItem highlight="{path: 'view>rowState', formatter: 'formatter.rowHighlight'}" class="rankingRow"><HBox width="100%" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap"><VBox class="rankCell"><Text text="RANK" class="columnLabel"/><Title text="#{view>priority_rank}" level="H3"/></VBox><VBox class="wideCell"><Text text="MANIFEST ID" class="columnLabel"/><Text text="{view>manifest_id}"/></VBox><VBox class="wideCell"><Text text="COMMODITY TYPE" class="columnLabel"/><Text text="{view>commodity_type}"/></VBox><VBox class="scoreCell"><Text text="COMPOSITE SCORE" class="columnLabel"/><ObjectNumber number="{view>composite_score}" state="Information"/></VBox><VBox class="statusCell"><Text text="ALLOCATED" class="columnLabel"/><ObjectStatus text="{view>allocatedText}" state="{path: 'view>allocated', formatter: 'formatter.allocatedState'}"/></VBox><VBox class="statusCell"><Text text="REQUIRES APPROVAL" class="columnLabel"/><ObjectStatus text="{view>approvalText}" state="{path: 'view>requires_approval', formatter: 'formatter.approvalState'}" inverted="true"/></VBox></HBox></CustomListItem></items></List></VBox></IconTabFilter>
        <IconTabFilter key="approvals" text="Approval Queue" icon="sap-icon://task" count="{view>/summary/pending}"><VBox class="screenContent"><Title text="Human-in-the-Loop Approval Queue" level="H2"/><Text text="High-stakes allocations remain paused until a named reviewer decides." class="screenSubtitle"/><List items="{view>/approvals}" noDataText="No approvals are waiting." class="approvalList"><items><CustomListItem highlight="Warning" class="approvalRow"><VBox><HBox justifyContent="SpaceBetween" wrap="Wrap" alignItems="Center"><VBox><Title text="{view>commodity_type}" level="H4"/><Text text="{view>manifest_id}  •  Priority #{view>priority_rank}  •  Score {view>composite_score}"/></VBox><ObjectStatus text="HUMAN REVIEW REQUIRED" state="Warning" inverted="true"/></HBox><Text text="Escalation reason: {view>escalationReason}" class="escalationReason"/><HBox wrap="Wrap" alignItems="End" class="approvalActions"><VBox class="approvalInput"><Label text="Reviewer name"/><Input value="{view>approver_name}" placeholder="Your name"/></VBox><VBox class="reasonInput"><Label text="Rejection reason (if rejecting)"/><Input value="{view>rejection_reason}" placeholder="Required to reject"/></VBox><Button text="Approve" type="Accept" icon="sap-icon://accept" press=".onApprove"/><Button text="Reject" type="Reject" icon="sap-icon://decline" press=".onReject"/></HBox></VBox></CustomListItem></items></List></VBox></IconTabFilter>
        <IconTabFilter key="audit" text="Audit Trail" icon="sap-icon://activity-items"><VBox class="screenContent"><Title text="Agent Decision Audit Trail" level="H2"/><Text text="Every automated and human decision is timestamped, attributed, and reviewable." class="screenSubtitle"/><List items="{view>/audit}" noDataText="No audit events recorded yet." class="auditList"><items><CustomListItem><HBox alignItems="Start"><ObjectStatus text="{view>actorLabel}" state="{path: 'view>actor', formatter: 'formatter.actorState'}" inverted="true" class="actorBadge"/><VBox class="auditContent"><Text text="{path: 'view>timestamp', formatter: 'formatter.timestamp'}" class="auditTime"/><Text text="{view>decision_rationale}" wrapping="true"/></VBox></HBox></CustomListItem></items></List></VBox></IconTabFilter>
      </items>
    </IconTabBar></f:content>
  </f:DynamicPage>
</mvc:View>
