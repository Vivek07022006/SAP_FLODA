{
  "name": "floda-hackathon",
  "version": "1.0.0",
  "description": "FLODA - Multi-party logistics commons for SAP Hackfest 2026",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10.1.1",
    "express": "^4",
    "sql.js": "^1.14.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "cds-plugin-ui5": "^0.17.4"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
